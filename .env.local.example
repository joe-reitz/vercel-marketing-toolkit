# ─── Email Catalogue ───────────────────────────────────────────────────────────
# In production these live in the Vercel project's Environment Variables, not in
# a file. The snapshot is built during `next build`, so the build container is
# where the credential is needed — nothing reads it at runtime.
#
# Copy this file to .env.local only if you want to run the ingest locally.

# Customer.io App API bearer token. Same value as CUSTOMERIO_APP_API_KEY in the
# mOperator Vercel project (github.com/vercel/vercel-moperator).
#
# This is the App API key (Workspace Settings → API Credentials → App API Keys),
# NOT the Track API site id/key pair, and NOT a service account token — those
# authenticate a different host (fly.customer.io) and are rejected by the
# api.customer.io/v1 endpoints used here.
#
# Without this, the build skips the ingest and the page shows setup instructions.
CUSTOMERIO_APP_API_KEY=

# Set to "eu" for EU-hosted workspaces. Defaults to "us".
CUSTOMERIO_REGION=us

# Requests per second for the ingest. Customer.io documents a 10/s ceiling;
# the default of 8 leaves headroom.
CIO_RPS=8

# ─── Nightly refresh (Vercel only) ─────────────────────────────────────────────
# Click data changes daily, so the catalogue is refreshed by redeploying. The
# cron in vercel.json calls /api/email-catalogue/refresh, which POSTs a Deploy
# Hook to rebuild and re-ingest.

# Vercel → Project Settings → Git → Deploy Hooks → create one on `main`.
CATALOGUE_DEPLOY_HOOK_URL=

# Any random string. Vercel sends it as a bearer token on cron invocations; the
# refresh route rejects requests without it, so the endpoint isn't a public
# redeploy button. The route fails closed if this is unset.
CRON_SECRET=

# Preview deploys skip the ingest by default — otherwise every preview re-reads
# the whole archive and burns the shared rate limit. Set to "true" to opt in.
CATALOGUE_INGEST_ON_PREVIEW=false
